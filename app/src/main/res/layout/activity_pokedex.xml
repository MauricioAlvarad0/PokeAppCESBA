<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Imagen de fondo de la Pokédex -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/pokedex_bg" />

    <!-- Capa semitransparente oscura para asegurar legibilidad -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30A192F" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="POKÉDEX"
            android:textColor="#FFCC00"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Luces Kanto estéticas -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.card.MaterialCardView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="6dp" app:cardBackgroundColor="#28AAFE" app:cardCornerRadius="8dp" app:strokeColor="#FFFFFF" app:strokeWidth="1dp"/>
            <com.google.android.material.card.MaterialCardView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginEnd="6dp" app:cardBackgroundColor="#EF4444" app:cardCornerRadius="8dp" app:strokeColor="#FFFFFF" app:strokeWidth="1dp"/>
            <com.google.android.material.card.MaterialCardView android:layout_width="16dp" android:layout_height="16dp" app:cardBackgroundColor="#10B981" app:cardCornerRadius="8dp" app:strokeColor="#FFFFFF" app:strokeWidth="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <View android:id="@+id/dividerLine" android:layout_width="match_parent" android:layout_height="2dp" android:background="#1E293B" app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Área de Búsqueda y Favoritos -->
    <LinearLayout
        android:id="@+id/searchArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/dividerLine">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="16dp"
            app:strokeColor="#334155"
            app:strokeWidth="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/etBusqueda" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:hint="Busca un Pokémon (ej. Pikachu)..." android:textColor="#FFFFFF" android:textColorHint="#94A3B8" android:paddingHorizontal="16dp" android:textStyle="bold" android:textSize="15sp"/>
                <Button android:id="@+id/btnBuscar" android:layout_width="55dp" android:layout_height="match_parent" android:background="@android:color/transparent" android:text="🔎" android:textSize="20sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnVerFavoritos"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FFCC00"
            android:text="⭐ VER MIS FAVORITOS"
            android:textColor="#0A192F"
            android:textStyle="bold"
            app:cornerRadius="12dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchArea">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPokemon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="20dp"
            app:strokeColor="#334155"
            app:strokeWidth="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <!-- Pantalla del Sprite -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#0F172A"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="4dp"
                    android:layout_marginBottom="16dp">

                    <ImageView android:id="@+id/ivSprite" android:layout_width="200dp" android:layout_height="200dp" android:layout_gravity="center" android:layout_margin="12dp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Cabecera de Datos -->
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#0F172A" android:padding="14dp" android:elevation="2dp">
                    <TextView android:id="@+id/tvId" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#000" android:textColor="#94A3B8" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvNombre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/tvId" android:text="Nombre" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:textAllCaps="true" />

                    <CheckBox android:id="@+id/btnFavorito" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:button="@android:drawable/btn_star" android:buttonTint="#FFCC00" android:scaleX="1.6" android:scaleY="1.6"/>
                </RelativeLayout>

                <TextView android:id="@+id/tvInfoGral" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="center" android:textColor="#E2E8F0" android:layout_marginVertical="12dp" android:textStyle="bold" android:textSize="14sp"/>

                <!-- Stats -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="PS" android:textColor="#E2E8F0" android:textStyle="bold" android:textSize="13sp" /><ProgressBar android:id="@+id/pbHp" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="12dp" android:max="255" android:progressTint="#EF4444" /><TextView android:id="@+id/tvHp" android:layout_width="35dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp"><TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="Ataque" android:textColor="#E2E8F0" android:textStyle="bold" android:textSize="13sp" /><ProgressBar android:id="@+id/pbAtk" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="12dp" android:max="255" android:progressTint="#F97316" /><TextView android:id="@+id/tvAtk" android:layout_width="35dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp"><TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="Defensa" android:textColor="#E2E8F0" android:textStyle="bold" android:textSize="13sp" /><ProgressBar android:id="@+id/pbDef" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="12dp" android:max="255" android:progressTint="#2563EB" /><TextView android:id="@+id/tvDef" android:layout_width="35dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp"><TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="Atq. Esp." android:textColor="#E2E8F0" android:textStyle="bold" android:textSize="13sp" /><ProgressBar android:id="@+id/pbSpAtk" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="12dp" android:max="255" android:progressTint="#8B5CF6" /><TextView android:id="@+id/tvSpAtk" android:layout_width="35dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp"><TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="Def. Esp." android:textColor="#E2E8F0" android:textStyle="bold" android:textSize="13sp" /><ProgressBar android:id="@+id/pbSpDef" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="12dp" android:max="255" android:progressTint="#10B981" /><TextView android:id="@+id/tvSpDef" android:layout_width="35dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/></LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp" android:layout_marginBottom="16dp"><TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="Velocidad" android:textColor="#E2E8F0" android:textStyle="bold" android:textSize="13sp" /><ProgressBar android:id="@+id/pbSpd" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="12dp" android:max="255" android:progressTint="#EC4899" /><TextView android:id="@+id/tvSpd" android:layout_width="35dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/></LinearLayout>

                <Button android:id="@+id/btnCry" android:layout_width="match_parent" android:layout_height="50dp" android:backgroundTint="#334155" android:text="🔊 REPRODUCIR SONIDO" android:textColor="#FFFFFF" android:textStyle="bold" app:cornerRadius="25dp" />

                <!-- Carrusel de Formas Alternas -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#0F172A"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Toca para ver Formas Alternas" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>

                        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="80dp" android:layout_height="80dp" app:cardCornerRadius="40dp" app:cardBackgroundColor="#1E293B" app:strokeColor="#475569" app:strokeWidth="2dp">
                                        <ImageView android:id="@+id/ivBack" android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="center" android:clickable="true" android:focusable="true"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Espalda" android:textColor="#94A3B8" android:layout_marginTop="6dp" android:textSize="12sp" android:textStyle="bold"/>
                                </LinearLayout>

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#64748B" android:textSize="28sp" android:textStyle="bold" android:layout_marginHorizontal="12dp"/>

                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="80dp" android:layout_height="80dp" app:cardCornerRadius="40dp" app:cardBackgroundColor="#1E293B" app:strokeColor="#475569" app:strokeWidth="2dp">
                                        <ImageView android:id="@+id/ivShiny" android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="center" android:clickable="true" android:focusable="true"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shiny" android:textColor="#94A3B8" android:layout_marginTop="6dp" android:textSize="12sp" android:textStyle="bold"/>
                                </LinearLayout>

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#64748B" android:textSize="28sp" android:textStyle="bold" android:layout_marginHorizontal="12dp"/>

                                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                                    <com.google.android.material.card.MaterialCardView android:layout_width="80dp" android:layout_height="80dp" app:cardCornerRadius="40dp" app:cardBackgroundColor="#1E293B" app:strokeColor="#475569" app:strokeWidth="2dp">
                                        <ImageView android:id="@+id/ivShinyBack" android:layout_width="70dp" android:layout_height="70dp" android:layout_gravity="center" android:clickable="true" android:focusable="true"/>
                                    </com.google.android.material.card.MaterialCardView>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shiny Esp." android:textColor="#94A3B8" android:layout_marginTop="6dp" android:textSize="12sp" android:textStyle="bold"/>
                                </LinearLayout>

                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
