<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#DC0A2D"> <!-- Rojo Clásico Pokédex -->

    <!-- Cabecera de Lentes -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLenses"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Lente Azul Principal -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bigLens"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="#28AAFE"
            app:cardCornerRadius="32dp"
            app:strokeColor="#FFFFFF"
            app:strokeWidth="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <!-- Reflejo -->
            <View android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_rounded_white" android:alpha="0.4" android:layout_margin="8dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Lentes pequeños (Rojo, Amarillo, Verde) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lensRed"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#EF4444"
            app:cardCornerRadius="8dp"
            app:strokeColor="#000000"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="@id/bigLens"
            app:layout_constraintStart_toEndOf="@id/bigLens"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lensYellow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="#F59E0B"
            app:cardCornerRadius="8dp"
            app:strokeColor="#000000"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="@id/lensRed"
            app:layout_constraintStart_toEndOf="@id/lensRed"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lensGreen"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="#10B981"
            app:cardCornerRadius="8dp"
            app:strokeColor="#000000"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="@id/lensRed"
            app:layout_constraintStart_toEndOf="@id/lensYellow"/>

        <!-- Botón de Retroceso -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#000000"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View android:id="@+id/dividerLine" android:layout_width="match_parent" android:layout_height="4dp" android:background="#8B0000" app:layout_constraintTop_toBottomOf="@id/headerLenses" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/dividerLine"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Marco Blanco de la Pantalla Principal -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#DEDEDE"
                app:cardCornerRadius="16dp"
                app:strokeColor="#555555"
                app:strokeWidth="2dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <!-- Dos puntitos rojos arriba de la pantalla -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginBottom="8dp">
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_rounded_white" android:backgroundTint="#EF4444" android:layout_marginEnd="16dp"/>
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_rounded_white" android:backgroundTint="#EF4444"/>
                    </LinearLayout>

                    <!-- Pantalla Negra del Sprite -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        app:cardBackgroundColor="#222222"
                        app:cardCornerRadius="8dp">
                        <ImageView android:id="@+id/ivSprite" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="16dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Botón Rojo (Decorativo) y Bocina -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:cardBackgroundColor="#EF4444"
                            app:cardCornerRadius="12dp"
                            app:strokeColor="#000"
                            app:strokeWidth="1dp"
                            android:layout_weight="0"/>

                        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                            <View android:layout_width="30dp" android:layout_height="4dp" android:background="#555" android:layout_marginBottom="4dp"/>
                            <View android:layout_width="30dp" android:layout_height="4dp" android:background="#555" android:layout_marginBottom="4dp"/>
                            <View android:layout_width="30dp" android:layout_height="4dp" android:background="#555"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- D-Pad y Botones Medios (Decorativos / Opcionales) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:paddingHorizontal="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardBackgroundColor="#222222"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="#000"
                    app:strokeWidth="1dp"/>

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                <!-- Botón de forma (Rojo y Azul) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="60dp"
                    android:layout_height="12dp"
                    app:cardBackgroundColor="#EF4444"
                    app:cardCornerRadius="6dp"
                    app:strokeColor="#000"
                    app:strokeWidth="1dp"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="60dp"
                    android:layout_height="12dp"
                    app:cardBackgroundColor="#3B82F6"
                    app:cardCornerRadius="6dp"
                    app:strokeColor="#000"
                    app:strokeWidth="1dp"/>

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                <!-- D-Pad (Representado con un icono de cruzeta) -->
                <ImageView android:layout_width="60dp" android:layout_height="60dp" android:src="@android:drawable/ic_menu_directions" app:tint="#222222" android:scaleType="fitXY"/>
            </LinearLayout>

            <!-- Panel de Información (Pantalla Verde tipo LCD Antiguo) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#111111"
                app:cardCornerRadius="8dp"
                app:strokeColor="#000"
                app:strokeWidth="4dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <!-- Búsqueda Integrada a la Pantalla Verde -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#4ADE80" android:padding="8dp" android:layout_marginBottom="12dp">
                        <EditText android:id="@+id/etBusqueda" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:hint="Ingresa Nombre o ID" android:textColor="#000" android:textColorHint="#22543D" android:textStyle="bold" android:textSize="14sp"/>
                        <Button android:id="@+id/btnBuscar" android:layout_width="45dp" android:layout_height="45dp" android:backgroundTint="#22543D" android:text="🔎" android:textColor="#FFF" app:cornerRadius="4dp" android:padding="0dp"/>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPokemon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#4ADE80"
                        app:cardCornerRadius="4dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">

                            <!-- Nombre e ID -->
                            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                                <TextView android:id="@+id/tvId" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#000" android:textColor="#14532D" android:textSize="16sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvNombre" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/tvId" android:text="POKEMON" android:textColor="#000000" android:textSize="22sp" android:textStyle="bold" android:textAllCaps="true" />
                                <CheckBox android:id="@+id/btnFavorito" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:button="@android:drawable/btn_star" android:buttonTint="#000" android:scaleX="1.4" android:scaleY="1.4"/>
                            </RelativeLayout>

                            <TextView android:id="@+id/tvInfoGral" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="center" android:textColor="#064E3B" android:layout_marginTop="8dp" android:textStyle="bold" android:textSize="12sp"/>
                            <TextView android:id="@+id/tvHabilidades" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="center" android:textColor="#064E3B" android:layout_marginBottom="8dp" android:textStyle="bold" android:textSize="12sp"/>

                            <!-- Stats (Minimalistas sobre verde) -->
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="PS" android:textColor="#000" android:textStyle="bold" android:textSize="12sp" /><ProgressBar android:id="@+id/pbHp" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:max="255" android:progressTint="#064E3B" android:backgroundTint="#86EFAC"/><TextView android:id="@+id/tvHp" android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#000" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp"><TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Ataque" android:textColor="#000" android:textStyle="bold" android:textSize="12sp" /><ProgressBar android:id="@+id/pbAtk" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:max="255" android:progressTint="#064E3B" android:backgroundTint="#86EFAC"/><TextView android:id="@+id/tvAtk" android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#000" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp"><TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Defensa" android:textColor="#000" android:textStyle="bold" android:textSize="12sp" /><ProgressBar android:id="@+id/pbDef" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:max="255" android:progressTint="#064E3B" android:backgroundTint="#86EFAC"/><TextView android:id="@+id/tvDef" android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#000" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp"><TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Atq. Esp." android:textColor="#000" android:textStyle="bold" android:textSize="12sp" /><ProgressBar android:id="@+id/pbSpAtk" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:max="255" android:progressTint="#064E3B" android:backgroundTint="#86EFAC"/><TextView android:id="@+id/tvSpAtk" android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#000" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp"><TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Def. Esp." android:textColor="#000" android:textStyle="bold" android:textSize="12sp" /><ProgressBar android:id="@+id/pbSpDef" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:max="255" android:progressTint="#064E3B" android:backgroundTint="#86EFAC"/><TextView android:id="@+id/tvSpDef" android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#000" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp"><TextView android:layout_width="80dp" android:layout_height="wrap_content" android:text="Velocidad" android:textColor="#000" android:textStyle="bold" android:textSize="12sp" /><ProgressBar android:id="@+id/pbSpd" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="8dp" android:max="255" android:progressTint="#064E3B" android:backgroundTint="#86EFAC"/><TextView android:id="@+id/tvSpd" android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="#000" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>

                            <!-- Botones Cuadrados Azules y Panel Derecha -->
                            <GridLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:columnCount="2"
                                android:layout_marginTop="16dp">
                                <Button android:id="@+id/btnCry" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="45dp" android:backgroundTint="#0284C7" android:text="🔊 GRITO" android:textColor="#FFF" android:textSize="12sp" android:textStyle="bold" app:cornerRadius="4dp" android:layout_margin="4dp" app:strokeColor="#000" app:strokeWidth="1dp"/>
                                <Button android:id="@+id/btnVerFavoritos" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="45dp" android:backgroundTint="#0284C7" android:text="⭐ MIS FAVS" android:textColor="#FFF" android:textSize="12sp" android:textStyle="bold" app:cornerRadius="4dp" android:layout_margin="4dp" app:strokeColor="#000" app:strokeWidth="1dp"/>
                            </GridLayout>

                            <!-- Formas Múltiples (Como ventanitas LCD verdes) -->
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FORMAS ALTERNAS" android:textColor="#064E3B" android:textSize="10sp" android:textStyle="bold" android:textAlignment="center" android:layout_marginTop="8dp"/>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="4dp">
                                <com.google.android.material.card.MaterialCardView android:layout_width="50dp" android:layout_height="50dp" app:cardBackgroundColor="#86EFAC" app:cardCornerRadius="4dp" app:strokeColor="#064E3B" app:strokeWidth="1dp" android:layout_margin="4dp">
                                    <ImageView android:id="@+id/ivBack" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true"/>
                                </com.google.android.material.card.MaterialCardView>
                                <com.google.android.material.card.MaterialCardView android:layout_width="50dp" android:layout_height="50dp" app:cardBackgroundColor="#86EFAC" app:cardCornerRadius="4dp" app:strokeColor="#064E3B" app:strokeWidth="1dp" android:layout_margin="4dp">
                                    <ImageView android:id="@+id/ivShiny" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true"/>
                                </com.google.android.material.card.MaterialCardView>
                                <com.google.android.material.card.MaterialCardView android:layout_width="50dp" android:layout_height="50dp" app:cardBackgroundColor="#86EFAC" app:cardCornerRadius="4dp" app:strokeColor="#064E3B" app:strokeWidth="1dp" android:layout_margin="4dp">
                                    <ImageView android:id="@+id/ivShinyBack" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true"/>
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>