<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pokedex_bg"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/llHeaderPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_battle_text"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackPerfil"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#000000"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👤 MI PERFIL DE ENTRENADOR 👤"
            android:textAlignment="center"
            android:fontFamily="@font/pokemon_pixel"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/llHeaderPerfil"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Trainer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_dialog_game_over"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <FrameLayout
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_gold_frame"
                    android:padding="6dp">
                    <ImageView
                        android:id="@+id/ivPerfilAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_mi_perfil"
                        android:scaleType="fitCenter"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPerfilTrainerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entrenador: Mauricio"
                    android:textColor="#FACC15"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvPerfilEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="email@ejemplo.com"
                    android:textColor="#94A3B8"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEditTrainerName"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_button_retro"
                    android:fontFamily="@font/pokemon_pixel"
                    android:text="✏️ CAMBIAR NOMBRE"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Stats Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dialog_game_over"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 ESTADÍSTICAS Y RÉCORDS 📊"
                    android:textColor="#FACC15"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvStatMedals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎖️ Medallas de la Torre: 0 / 10"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvStatVersus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚔️ Duelos Versus: 0 Victorias | 0 Derrotas"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvStatFlappy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🦅 Flappy Poké Récord: 0 Puntos"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvStatWhos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="❓ ¿Quién es ese Pokémon?: 0 Racha"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvStatTypeMaster"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Maestro de Tipos: 0 Racha"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvStatMemory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧠 PokéMemory: -- Movimientos"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvStatSafari"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌾 Safari Capturados: 0 Pokémon"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="16sp"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvStatFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐ Pokémon Favoritos: 0 Guardados"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/pokemon_pixel"
                    android:textSize="16sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
