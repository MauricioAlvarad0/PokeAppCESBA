<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Imagen de fondo completa usando el wallpaper original -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/logo_pokeapp" />

    <!-- Capa de gradiente oscuro (Recrea la division diagonal con color overlay) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000022" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="16dp">

            <!-- Título CESBA (Estilo Logo Superpuesto 3D) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">
                <!-- Sombra / Borde -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CESBA"
                    android:textColor="#FDE047"
                    android:textSize="72sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pokemon_pixel"
                    android:translationY="6dp"/>
                <!-- Relleno -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CESBA"
                    android:textColor="#38BDF8"
                    android:textSize="72sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pokemon_pixel" />
            </FrameLayout>

            <!-- Contenedor Principal con el Marco Dorado de Pikachu asomándose -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Tarjeta Principal Blanca Metálica (Retro Panel) -->
                <LinearLayout
                    android:id="@+id/cardLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="80dp"
                    android:background="@drawable/bg_panel_retro"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="24dp"
                    android:paddingBottom="24dp"
                    android:paddingTop="60dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:text="INICIAR SESIÓN"
                        android:textAlignment="center"
                        android:textColor="#1E293B"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/pokemon_pixel"/>

                    <!-- Caja de Nombre (Para Registro) -->
                    <LinearLayout
                        android:id="@+id/layoutName"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_input_retro"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        android:gravity="center_vertical">
                        <EditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Nombre de Entrenador"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#94A3B8"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="16dp"
                            android:textSize="18sp"
                            android:fontFamily="@font/pokemon_pixel"/>
                    </LinearLayout>

                    <!-- Caja de Correo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_input_retro"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical">
                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Correo"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#94A3B8"
                            android:inputType="textEmailAddress"
                            android:paddingHorizontal="16dp"
                            android:textSize="18sp"
                            android:fontFamily="@font/pokemon_pixel"/>
                    </LinearLayout>

                    <!-- Caja de Contraseña -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_input_retro"
                        android:layout_marginBottom="24dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Contraseña"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#94A3B8"
                            android:inputType="textPassword"
                            android:paddingHorizontal="16dp"
                            android:textSize="18sp"
                            android:fontFamily="@font/pokemon_pixel"/>

                        <!-- Icono de Ojito de contraseña -->
                        <ImageView
                            android:id="@+id/ivTogglePass"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="#94A3B8"
                            android:padding="8dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- Botones -->
                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="65dp"
                        android:background="@drawable/bg_button_retro"
                        android:text="INICIAR SESIÓN"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/pokemon_pixel"
                        app:backgroundTint="@null"/>

                    <TextView
                        android:id="@+id/btnRegister"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="REGISTRARME"
                        android:textAlignment="center"
                        android:textColor="#0284C7"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/pokemon_pixel"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/tvOlvidePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="¿OLVIDASTE TU CONTRASEÑA?"
                        android:textAlignment="center"
                        android:textColor="#64748B"
                        android:textSize="16sp"
                        android:fontFamily="@font/pokemon_pixel"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Marco Dorado de Pikachu Superpuesto -->
                <LinearLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/bg_gold_frame"
                    android:gravity="center"
                    android:elevation="10dp">

                    <ImageView
                        android:id="@+id/ivLoginPokemon"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:scaleType="fitCenter"/>
                </LinearLayout>

                <!-- Adornos Esquinas de la Tarjeta Blanca -->
                <View android:layout_width="16dp" android:layout_height="16dp" android:layout_alignStart="@id/cardLogin" android:layout_alignTop="@id/cardLogin" android:layout_marginTop="72dp" android:layout_marginStart="-8dp" android:background="#38BDF8" android:rotation="45" android:elevation="20dp"/>
                <View android:layout_width="16dp" android:layout_height="16dp" android:layout_alignEnd="@id/cardLogin" android:layout_alignTop="@id/cardLogin" android:layout_marginTop="72dp" android:layout_marginEnd="-8dp" android:background="#38BDF8" android:rotation="45" android:elevation="20dp"/>
                <View android:layout_width="16dp" android:layout_height="16dp" android:layout_alignStart="@id/cardLogin" android:layout_alignBottom="@id/cardLogin" android:layout_marginBottom="-8dp" android:layout_marginStart="-8dp" android:background="#EF4444" android:rotation="45" android:elevation="20dp"/>
                <View android:layout_width="16dp" android:layout_height="16dp" android:layout_alignEnd="@id/cardLogin" android:layout_alignBottom="@id/cardLogin" android:layout_marginBottom="-8dp" android:layout_marginEnd="-8dp" android:background="#D946EF" android:rotation="45" android:elevation="20dp"/>

            </RelativeLayout>

            <!-- Títulos Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- PRESS START -"
                    android:textColor="#FDE047"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/pokemon_pixel"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="POKÉAPP V2"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="2"
                    android:fontFamily="@font/pokemon_pixel"
                    android:layout_marginVertical="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BY VICTOR VARGAS"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:fontFamily="@font/pokemon_pixel"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>