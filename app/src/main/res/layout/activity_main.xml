<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Imagen de fondo -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/pokedex_bg" />

    <!-- Capa semitransparente oscura para legibilidad -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Botón Atrás -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="22.5dp"
            app:strokeColor="#94A3B8"
            app:strokeWidth="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:drawable/ic_menu_revert" app:tint="#FFFFFF" android:padding="10dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Opciones -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnOptions"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="22.5dp"
            app:strokeColor="#94A3B8"
            app:strokeWidth="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#FFFFFF" android:padding="10dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Badge Entrenador -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            app:cardBackgroundColor="#0284C7"
            app:cardCornerRadius="12dp"
            app:strokeColor="#38BDF8"
            app:strokeWidth="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="20dp"
            app:cardElevation="8dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:paddingStart="40dp" android:paddingEnd="20dp">
                <TextView
                    android:id="@+id/tvSaludo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENTRENADOR:\nMAURICIO"
                    android:textColor="#FDE047"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:fontFamily="@font/pokemon_pixel"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Avatar Entrenador superpuesto -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="65dp"
            android:layout_height="65dp"
            app:cardBackgroundColor="#F8FAFC"
            app:cardCornerRadius="32.5dp"
            app:strokeColor="#38BDF8"
            app:strokeWidth="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.20"
            app:cardElevation="10dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#1E293B"
                android:padding="12dp"
                android:background="#E2E8F0"/>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Grid Completo de 13 Botones -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <!-- A. Pokédex -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuPokedex" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#EF4444" app:cardCornerRadius="16dp" app:strokeColor="#FCA5A5" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_view" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A. POKÉDEX" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- B. Emulator -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuEmulator" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#F97316" app:cardCornerRadius="16dp" app:strokeColor="#FDBA74" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_close_clear_cancel" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B. BATTLE\nEMULATOR" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- C. Versus -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuVersus" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#3B82F6" app:cardCornerRadius="16dp" app:strokeColor="#93C5FD" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_mylocation" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C. BATTLE\nVERSUS" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- D. Torre -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuTorre" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#A855F7" app:cardCornerRadius="16dp" app:strokeColor="#D8B4FE" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D. TORRE\nPOKÉMON" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- E. Quien es -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuQuienEs" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#EAB308" app:cardCornerRadius="16dp" app:strokeColor="#FDE047" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_help" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="E. ¿QUIÉN ES\nESE POKÉMON?" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- F. Safari -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuSafari" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#22C55E" app:cardCornerRadius="16dp" app:strokeColor="#86EFAC" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_camera" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="F. SAFARI\nPOKÉMON" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- G. Maestro de Tipos -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuMaestro" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#EC4899" app:cardCornerRadius="16dp" app:strokeColor="#F9A8D4" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_share" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G. MAESTRO\nDE TIPOS" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- H. Memory -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuMemory" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#0EA5E9" app:cardCornerRadius="16dp" app:strokeColor="#7DD3FC" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_gallery" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="H. POKÉMEMORY" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- I. Favoritos -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuFavoritos" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#EF4444" app:cardCornerRadius="16dp" app:strokeColor="#FCA5A5" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_zoom" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="I. FAVORITOS" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- J. Historial -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuHistorial" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#1E3A8A" app:cardCornerRadius="16dp" app:strokeColor="#93C5FD" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_agenda" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J. HISTORIAL" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- K. Medallas -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuMedallas" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#475569" app:cardCornerRadius="16dp" app:strokeColor="#94A3B8" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_compass" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="K. MEDALLAS" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- L. Mi Perfil -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/btnMenuPerfil" android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_margin="6dp" app:cardBackgroundColor="#A855F7" app:cardCornerRadius="16dp" app:strokeColor="#D8B4FE" app:strokeWidth="2dp" app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/white" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L. MI PERFIL" android:textColor="@color/white" android:textSize="11sp" android:textStyle="bold" android:textAlignment="center" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- M. Configuración -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnMenuConfiguracion"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_columnSpan="3"
                android:layout_margin="6dp"
                app:cardBackgroundColor="#64748B"
                app:cardCornerRadius="12dp"
                app:strokeColor="#94A3B8"
                app:strokeWidth="3dp"
                app:cardElevation="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:background="?attr/selectableItemBackground">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_preferences" app:tint="@color/white"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:text="M. CONFIGURACIÓN" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_preferences" app:tint="@color/white"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>
    </ScrollView>

    <!-- Barra Inferior -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="#80000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ivNavHome"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="25dp"
            app:strokeColor="#0EA5E9"
            app:strokeWidth="3dp"
            android:layout_marginHorizontal="8dp"
            app:cardElevation="8dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:drawable/ic_menu_today" app:tint="#0EA5E9" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ivNavPokedex"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="25dp"
            app:strokeColor="#F97316"
            app:strokeWidth="3dp"
            android:layout_marginHorizontal="8dp"
            app:cardElevation="8dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#F97316" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ivNavCompass"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="25dp"
            app:strokeColor="#22C55E"
            app:strokeWidth="3dp"
            android:layout_marginHorizontal="8dp"
            app:cardElevation="8dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:drawable/ic_menu_compass" app:tint="#22C55E" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless"/>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCerrarSesion"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="25dp"
            app:strokeColor="#A855F7"
            app:strokeWidth="3dp"
            android:layout_marginHorizontal="8dp"
            app:cardElevation="8dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@android:drawable/ic_menu_myplaces" app:tint="#A855F7" android:padding="12dp" android:background="?attr/selectableItemBackgroundBorderless"/>
        </com.google.android.material.card.MaterialCardView>

        <ImageView android:id="@+id/ivNavAdd" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>