<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_minigame_safari"
    android:padding="16dp">

    <!-- Overlay oscuro para contraste -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#330F172A" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/llHeaderSafari"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_dialog_game_over"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackSafari"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌾 SAFARI POKÉMON 🌾"
            android:textAlignment="center"
            android:fontFamily="@font/pokemon_pixel"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FACC15"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3" />
    </LinearLayout>

    <!-- Stats Bar -->
    <LinearLayout
        android:id="@+id/llSafariStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/llHeaderSafari">

        <TextView
            android:id="@+id/tvSafariCaught"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_gold_frame"
            android:fontFamily="@font/pokemon_pixel"
            android:padding="8dp"
            android:text="CAPTURADOS: 0"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:textSize="14sp"
            android:layout_marginEnd="4dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tvSafariCoins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_retro"
            android:fontFamily="@font/pokemon_pixel"
            android:padding="8dp"
            android:text="SAFARI MONEDAS: 100"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Wild Pokemon Area -->
    <LinearLayout
        android:id="@+id/llWildArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#B30F172A"
        android:padding="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/llSafariStats"
        app:layout_constraintBottom_toTopOf="@id/llBallSelector">

        <TextView
            android:id="@+id/tvWildStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Buscando Pokémon en la hierba alta..."
            android:textColor="#FACC15"
            android:fontFamily="@font/pokemon_pixel"
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginBottom="12dp"/>

        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_gold_frame"
            android:padding="8dp">
            <ImageView
                android:id="@+id/ivWildSprite"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"/>
            <ImageView
                android:id="@+id/ivCaughtPokeball"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pokeball_vector"
                android:visibility="invisible" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvWildName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="..."
            android:textColor="#FFFFFF"
            android:fontFamily="@font/pokemon_pixel"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- Ball Selector -->
    <LinearLayout
        android:id="@+id/llBallSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/llActions">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SELECCIONA TU POKÉBALL:"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/pokemon_pixel"
            android:textSize="14sp"
            android:textAlignment="center"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPokeball"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/btn_retro_red"
                android:fontFamily="@font/pokemon_pixel"
                android:text="🔴 POKÉ (40%)"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginEnd="2dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSuperball"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_retro"
                android:fontFamily="@font/pokemon_pixel"
                android:text="🔵 SUPER (65%)"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginHorizontal="2dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnUltraball"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/btn_retro_gray"
                android:fontFamily="@font/pokemon_pixel"
                android:text="🟡 ULTRA (85%)"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginHorizontal="2dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMasterball"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_retro"
                android:fontFamily="@font/pokemon_pixel"
                android:text="🟣 MASTER (100%)"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:layout_marginStart="2dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/llActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCatch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_retro_red"
            android:fontFamily="@font/pokemon_pixel"
            android:text="🎯 LANZAR POKÉBALL"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRun"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/btn_retro_gray"
            android:fontFamily="@font/pokemon_pixel"
            android:text="🏃 BUSCAR OTRO"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivThrownPokeball"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_pokeball_vector"
        android:visibility="invisible"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/llBallSelector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
