<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- ========================================================= -->
    <!-- PANTALLA 1: SELECCIÓN DE EQUIPO ESTILO MORTAL KOMBAT      -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/llTeamSelection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F172A"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_dialog_game_over"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btnBackTower"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/btn_retro_gray"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pokemon_pixel"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="1"
                    android:text="TORRE CESBA · "
                    android:textColor="#FACC15"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pokemon_pixel"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="1"
                    android:text="DESAFÍO DE 6 PISOS"
                    android:textColor="#EF4444"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="36dp"
                android:layout_height="36dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtitleSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/pokemon_pixel"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:text="¡ELIGE 3 COMBATIENTES!\n(0/3)"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- COLUMNA IZQUIERDA: LA TORRE DE 6 PISOS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.46"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_dialog_game_over"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="6dp">

                <!-- PISO 6 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.35"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_gold_frame"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/ivDocente6"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/docente_cesba_6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="PISO 6: MEDINA PEDROZA RITA GUADALUPE"
                        android:textAlignment="center"
                        android:textColor="#FACC15"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="(JEFE FINAL)"
                        android:textAlignment="center"
                        android:textColor="#EF4444"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PISO 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_input_retro"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:id="@+id/ivDocente5"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_gold_frame"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/docente_cesba_5" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="PISO 5:\nMIRNA FUENTES"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PISO 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_input_retro"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:id="@+id/ivDocente4"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_gold_frame"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/docente_cesba_4" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="PISO 4:\nVARGAS AVILA VICTOR RICARDO"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PISO 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_input_retro"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:id="@+id/ivDocente3"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_gold_frame"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/docente_cesba_3" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="PISO 3:\nHERNANDEZ GOMEZ BADI URIEL"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PISO 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_input_retro"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <ImageView
                        android:id="@+id/ivDocente2"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_gold_frame"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/docente_cesba_2" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="PISO 2:\nCAMPA FERRUSCA JOSE EDUARDO"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- PISO 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.25"
                    android:background="@drawable/bg_input_retro"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivDocente1"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_gold_frame"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/docente_cesba_1" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/pokemon_pixel"
                            android:text="PISO 1:\nROJAS DOMINGUEZ EVERARDO"
                            android:textAlignment="center"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="#1E293B"
                        android:fontFamily="@font/pokemon_pixel"
                        android:paddingVertical="2dp"
                        android:text="🔥 NIVEL ACTUAL"
                        android:textAlignment="center"
                        android:textColor="#FACC15"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- COLUMNA DERECHA: 6 PELEADORES -->
            <GridLayout
                android:id="@+id/glPokemonSelection"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.54"
                android:background="@drawable/bg_dialog_game_over"
                android:columnCount="2"
                android:padding="6dp"
                android:rowCount="3" />
        </LinearLayout>

        <!-- CONTROLES INFERIORES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRandomTeam"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_retro_gray"
                android:fontFamily="@font/pokemon_pixel"
                android:text="🎲 EQUIPO ALEATORIO (?)"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStartTower"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/btn_retro_red"
                android:enabled="false"
                android:fontFamily="@font/pokemon_pixel"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="1"
                android:text="🔥 ¡INICIAR TORRE (0/3)! 🔥"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========================================================= -->
    <!-- PANTALLA 2: ARENA DE BATALLA (ALINEADA + ANIMACIONES)     -->
    <!-- ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTowerArena"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_battle_arena"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Banner Nivel y Docente -->
        <LinearLayout
            android:id="@+id/llLevelBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_retro"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivDocente"
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:background="@drawable/bg_gold_frame"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/docente_cesba_1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTowerLevel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pokemon_pixel"
                    android:text="NIVEL 1 DE 6"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDocenteName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pokemon_pixel"
                    android:text="Docente CESBA 1"
                    android:textColor="#333333"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAliveCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pokemon_pixel"
                android:text="Tú: 3 | Ene: 3"
                android:textColor="#FF3B30"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Área Central de Batalla -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBattleArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toTopOf="@id/flBottomControls"
            app:layout_constraintTop_toBottomOf="@id/llLevelBanner">

            <!-- HUD Enemigo (Arriba Izquierda) -->
            <LinearLayout
                android:id="@+id/llEnemyStats"
                android:layout_width="175dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_health_box"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEnemyName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="ENEMIGO"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="Lv.50"
                        android:textColor="#B45309"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#000000"
                        android:fontFamily="@font/pokemon_pixel"
                        android:paddingHorizontal="4dp"
                        android:text="HP"
                        android:textColor="#FFC107"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbEnemyHp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginStart="4dp"
                        android:progressDrawable="@drawable/hp_bar_states" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEnemyHpText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/pokemon_pixel"
                    android:text="HP: 100/100"
                    android:textAlignment="viewEnd"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- SPRITE ENEMIGO: Plantado exactamente sobre la plataforma circular superior derecha -->
            <ImageView
                android:id="@+id/ivEnemyPokemon"
                android:layout_width="145dp"
                android:layout_height="145dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.82"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.33" />

            <!-- SPRITE JUGADOR: Plantado exactamente sobre la plataforma circular inferior izquierda -->
            <ImageView
                android:id="@+id/ivPlayerPokemon"
                android:layout_width="155dp"
                android:layout_height="155dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.18"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.82" />

            <!-- HUD Jugador (Abajo Derecha) -->
            <LinearLayout
                android:id="@+id/llPlayerStats"
                android:layout_width="185dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_health_box"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPlayerName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="JUGADOR"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="Lv.50"
                        android:textColor="#B45309"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#000000"
                        android:fontFamily="@font/pokemon_pixel"
                        android:paddingHorizontal="4dp"
                        android:text="HP"
                        android:textColor="#FFC107"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbPlayerHp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginStart="4dp"
                        android:progressDrawable="@drawable/hp_bar_states" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPlayerHpText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/pokemon_pixel"
                    android:text="HP: 100/100"
                    android:textAlignment="viewEnd"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PROYECTIL ANIMADO (Fuego/Energía que viaja de un Pokémon a otro) -->
            <TextView
                android:id="@+id/tvProjectile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="16dp"
                android:text="🔥"
                android:textSize="38sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXTO FLOTANTE DE DAÑO (-25 HP) SOBRE EL POKÉMON GOLPEADO -->
            <TextView
                android:id="@+id/tvFloatingDamage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="20dp"
                android:fontFamily="@font/pokemon_pixel"
                android:shadowColor="#000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="2"
                android:text="-25 HP"
                android:textColor="#EF4444"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- PANEL INFERIOR: LOG DE BATALLA Y MENÚ ARCADE DE 4 ATAQUES -->
        <FrameLayout
            android:id="@+id/flBottomControls"
            android:layout_width="match_parent"
            android:layout_height="165dp"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- El Log de Batalla -->
            <ScrollView
                android:id="@+id/svBattleLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_battle_text"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvBattleLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pokemon_pixel"
                    android:lineSpacingExtra="3dp"
                    android:text="¡Empieza la batalla!"
                    android:textColor="#0F172A"
                    android:textSize="17sp" />
            </ScrollView>

            <!-- Menú Estilizado de 4 Ataques (Estilo Arcade / RPG) -->
            <LinearLayout
                android:id="@+id/llMovesContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_dialog_game_over"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pokemon_pixel"
                        android:gravity="center"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="1"
                        android:text="⚔️ SELECCIONA TU ATAQUE ⚔️"
                        android:textColor="#FACC15"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSwitchTowerPokemon"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/btn_retro_gray"
                        android:fontFamily="@font/pokemon_pixel"
                        android:paddingHorizontal="8dp"
                        android:text="🔄 CAMBIAR POKÉMON"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/glMoves"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:columnCount="2"
                    android:rowCount="2">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMove1"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/btn_retro_red"
                        android:fontFamily="@font/pokemon_pixel"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="1"
                        android:text="🔥 ATAQUE 1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMove2"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_button_retro"
                        android:fontFamily="@font/pokemon_pixel"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="1"
                        android:text="⚡ ATAQUE 2"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMove3"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_gold_frame"
                        android:fontFamily="@font/pokemon_pixel"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="1"
                        android:text="💥 ATAQUE 3"
                        android:textColor="#FACC15"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnMove4"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/btn_retro_gray"
                        android:fontFamily="@font/pokemon_pixel"
                        android:shadowColor="#000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="1"
                        android:text="⚔️ ATAQUE 4"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </GridLayout>
            </LinearLayout>

            <!-- Capa táctil para abrir los ataques cuando estás leyendo el Log -->
            <View
                android:id="@+id/viewLogTap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>