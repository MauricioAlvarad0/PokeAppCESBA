<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_minigame_types"
    android:padding="16dp">

    <!-- Overlay oscuro para contraste -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#330F172A" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/llHeaderType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_dialog_game_over"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackType"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ MAESTRO DE TIPOS ⚡"
            android:textAlignment="center"
            android:fontFamily="@font/pokemon_pixel"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FACC15"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3" />
    </LinearLayout>

    <!-- Score Bar -->
    <LinearLayout
        android:id="@+id/llTypeScores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/llHeaderType">

        <TextView
            android:id="@+id/tvTypeScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_retro"
            android:fontFamily="@font/pokemon_pixel"
            android:padding="8dp"
            android:text="PUNTOS: 0"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginEnd="4dp"/>

        <TextView
            android:id="@+id/tvTypeStreak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_gold_frame"
            android:fontFamily="@font/pokemon_pixel"
            android:padding="8dp"
            android:text="RACHA: 0"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:textSize="14sp"
            android:layout_marginHorizontal="2dp"/>

        <TextView
            android:id="@+id/tvTypeRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_game_over"
            android:fontFamily="@font/pokemon_pixel"
            android:padding="8dp"
            android:text="RÉCORD: 0"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Timer Progress -->
    <ProgressBar
        android:id="@+id/pbTimerType"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/hp_bar_states"
        app:layout_constraintTop_toBottomOf="@id/llTypeScores" />

    <!-- Question Card -->
    <LinearLayout
        android:id="@+id/llQuestionCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_dialog_game_over"
        android:padding="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/pbTimerType"
        app:layout_constraintBottom_toTopOf="@id/glTypeOptions">

        <TextView
            android:id="@+id/tvQuestionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡PREGUNTA DE TIPO!"
            android:textColor="#FACC15"
            android:fontFamily="@font/pokemon_pixel"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAlignment="center"/>

        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Qué tipo es SÚPER EFECTIVO contra el tipo FUEGO?"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/pokemon_pixel"
            android:textSize="18sp"
            android:textAlignment="center"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>

    <!-- Options Grid -->
    <GridLayout
        android:id="@+id/glTypeOptions"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTypeOptA"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/btn_retro_red"
            android:fontFamily="@font/pokemon_pixel"
            android:text="AGUA"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTypeOptB"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button_retro"
            android:fontFamily="@font/pokemon_pixel"
            android:text="PLANTA"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTypeOptC"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button_retro"
            android:fontFamily="@font/pokemon_pixel"
            android:text="ELÉCTRICO"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTypeOptD"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_button_retro"
            android:fontFamily="@font/pokemon_pixel"
            android:text="HIELO"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
