<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_rounded_white"
    android:backgroundTint="#99000000"
    android:padding="8dp">

    <!-- Date/Time -->
    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pokemon_pixel"
        android:text="14/10/2026 01:05"
        android:textColor="#58C4F8"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Winner Badge -->
    <TextView
        android:id="@+id/tvWinnerBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gold_frame"
        android:fontFamily="@font/pokemon_pixel"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="👑 GANADOR: CLAYDOL"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- VS Text in the middle -->
    <TextView
        android:id="@+id/tvVs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pokemon_pixel"
        android:text="VS"
        android:textColor="#FF0000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWinnerBadge" />

    <!-- Pokemon 1 (Left) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvVs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDate">

        <ImageView
            android:id="@+id/ivP1Sprite"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvP1Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pokemon_pixel"
            android:text="CLAYDOL"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2" />
    </LinearLayout>

    <!-- Pokemon 2 (Right) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvVs"
        app:layout_constraintTop_toBottomOf="@id/tvWinnerBadge">

        <ImageView
            android:id="@+id/ivP2Sprite"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvP2Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pokemon_pixel"
            android:text="HIPPOPOTAS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
