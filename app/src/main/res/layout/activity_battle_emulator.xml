<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/pokedex_bg">

    <!-- Capa oscura semitransparente para resaltar los paneles retro -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0F172A" />

    <!-- BARRA SUPERIOR RETRO -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_margin="10dp"
        android:background="@drawable/bg_dialog_game_over"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/btn_retro_gray"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/pokemon_pixel"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:text="⚔️ B. BATTLE EMULATOR ⚔️"
            android:textColor="#FACC15"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="36dp"
            android:layout_height="36dp" />
    </LinearLayout>

    <!-- ========================================================= -->
    <!-- ESTADO 1: SELECCIÓN DE CONTENDIENTES ESTILO ARCADE / RPG  -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/llSelection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/pokemon_pixel"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="2"
            android:text="¡ELIGE A LOS CONTENDIENTES!"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- CARTA JUGADOR 1 (TÚ) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_game_over"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Marco Dorado del Sprite P1 -->
            <LinearLayout
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gold_frame"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/ivPreviewP1"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pokedex_book" />

                <TextView
                    android:id="@+id/tvPreviewStatsP1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="#1E293B"
                    android:fontFamily="@font/pokemon_pixel"
                    android:gravity="center"
                    android:paddingVertical="2dp"
                    android:singleLine="true"
                    android:text="LISTO"
                    android:textColor="#4ADE80"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Controles de búsqueda P1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/pokemon_pixel"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="1"
                    android:text="🛡️ POKÉMON 1 (ESQUINA AZUL)"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etP1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_retro"
                        android:fontFamily="@font/pokemon_pixel"
                        android:hint="Nombre o ID (ej. 25)"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingHorizontal="10dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#CBD5E1"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRandomP1"
                        android:layout_width="46dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_retro"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="?"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- EMBLEMA CENTRAL VS ESTILO ARCADE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="#78350F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:background="@drawable/bg_gold_frame"
                android:fontFamily="@font/pokemon_pixel"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp"
                android:shadowColor="#000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="2"
                android:text="⚡ VS ⚡"
                android:textColor="#FACC15"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:background="#78350F" />
        </LinearLayout>

        <!-- CARTA JUGADOR 2 (RIVAL) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_game_over"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Marco Dorado del Sprite P2 -->
            <LinearLayout
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gold_frame"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/ivPreviewP2"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_battle_emulator" />

                <TextView
                    android:id="@+id/tvPreviewStatsP2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="#1E293B"
                    android:fontFamily="@font/pokemon_pixel"
                    android:gravity="center"
                    android:paddingVertical="2dp"
                    android:singleLine="true"
                    android:text="RIVAL"
                    android:textColor="#F87171"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Controles de búsqueda P2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/pokemon_pixel"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="1"
                    android:text="🔥 POKÉMON 2 (ESQUINA ROJA)"
                    android:textColor="#F87171"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etP2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_retro"
                        android:fontFamily="@font/pokemon_pixel"
                        android:hint="Nombre o ID (ej. 6)"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingHorizontal="10dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#CBD5E1"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRandomP2"
                        android:layout_width="46dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/btn_retro_red"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="?"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- BOTONES INFERIORES DE ACCIÓN -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRandomBoth"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_retro_gray"
            android:fontFamily="@font/pokemon_pixel"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:text="🎲 ELEGIR AMBOS AL AZAR (?)"
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPrepareBattle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/btn_retro_red"
            android:fontFamily="@font/pokemon_pixel"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:text="⚔️ PREPARAR BATALLA ⚔️"
            android:textColor="#FACC15"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- ESTADO 2: ARENA DE BATALLA (ALINEADA + PROYECTILES)       -->
    <!-- ========================================================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBattleArena"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- Área visual con el fondo del bosque y plataformas -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clArenaField"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_battle_arena"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
            app:layout_constraintTop_toTopOf="parent">

            <!-- HUD Rival (Arriba Izquierda) -->
            <LinearLayout
                android:id="@+id/cardP2"
                android:layout_width="185dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_health_box"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvP2Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="RIVAL"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="Lv.50"
                        android:textColor="#B45309"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#000000"
                        android:fontFamily="@font/pokemon_pixel"
                        android:paddingHorizontal="4dp"
                        android:text="HP"
                        android:textColor="#FFC107"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbP2Hp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginStart="4dp"
                        android:max="100"
                        android:progressDrawable="@drawable/hp_bar_states" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvP2Hp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/pokemon_pixel"
                    android:text="HP: 100/100"
                    android:textAlignment="viewEnd"
                    android:textColor="#000000"
                    android:textSize="12sp"
                    android:visibility="visible" />
            </LinearLayout>

            <!-- SPRITE RIVAL: Plantado sobre la plataforma superior derecha -->
            <ImageView
                android:id="@+id/ivP2Sprite"
                android:layout_width="145dp"
                android:layout_height="145dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.82"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.33" />

            <!-- SPRITE JUGADOR 1: Plantado sobre la plataforma inferior izquierda -->
            <ImageView
                android:id="@+id/ivP1Sprite"
                android:layout_width="155dp"
                android:layout_height="155dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.18"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.82" />

            <!-- HUD Jugador 1 (Abajo Derecha) -->
            <LinearLayout
                android:id="@+id/cardP1"
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_health_box"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvP1Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="JUGADOR"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pokemon_pixel"
                        android:text="Lv.50"
                        android:textColor="#B45309"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#000000"
                        android:fontFamily="@font/pokemon_pixel"
                        android:paddingHorizontal="4dp"
                        android:text="HP"
                        android:textColor="#FFC107"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbP1Hp"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginStart="4dp"
                        android:max="100"
                        android:progressDrawable="@drawable/hp_bar_states" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvP1Hp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/pokemon_pixel"
                    android:text="HP: 100/100"
                    android:textAlignment="viewEnd"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PROYECTIL ANIMADO -->
            <TextView
                android:id="@+id/tvEmulatorProjectile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="16dp"
                android:text="🔥"
                android:textSize="38sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- DAÑO FLOTANTE -->
            <TextView
                android:id="@+id/tvEmulatorFloatingDamage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="20dp"
                android:fontFamily="@font/pokemon_pixel"
                android:shadowColor="#000000"
                android:shadowDx="3"
                android:shadowDy="3"
                android:shadowRadius="2"
                android:text="-25 HP"
                android:textColor="#EF4444"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- CAJA DE TEXTO DE COMBATE ESTILO GBA / RETRO -->
        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:background="#0F172A"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <ScrollView
                android:id="@+id/svLog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_battle_text"
                android:fadeScrollbars="false"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvBattleLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pokemon_pixel"
                    android:lineSpacingExtra="5dp"
                    android:text="¡La batalla está por comenzar!"
                    android:textColor="#0F172A"
                    android:textSize="18sp" />
            </ScrollView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>