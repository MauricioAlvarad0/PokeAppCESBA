<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#0A192F"> <!-- Azul marino -->

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="BATTLE EMULATOR"
            android:textColor="#FFCC00"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View android:id="@+id/dividerLine" android:layout_width="match_parent" android:layout_height="2dp" android:background="#1E293B" app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- ESTADO 1: SELECCIÓN -->
    <LinearLayout
        android:id="@+id/llSelection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/dividerLine"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ELIGE A LOS\nCONTENDIENTES:"
            android:textColor="#FDE047"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:shadowColor="#000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="5"
            android:layout_marginBottom="24dp"/>

        <!-- Jugador 1 (TÚ) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="16dp"
            app:strokeColor="#0EA5E9"
            app:strokeWidth="3dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#220EA5E9"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POKÉMON 1 (TÚ)"
                        android:textColor="#38BDF8"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/bg_rounded_white"
                        android:backgroundTint="#1E293B"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <EditText
                            android:id="@+id/etP1"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#64748B"
                            android:hint="Nombre o ID..."
                            android:textSize="14sp"
                            android:maxLines="1"
                            android:inputType="text"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="#38BDF8"/>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    app:cardBackgroundColor="#0F172A"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="2dp"
                    android:layout_marginStart="16dp">

                    <ImageView
                        android:id="@+id/ivPreviewP1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_menu_help"
                        app:tint="#64748B"
                        android:padding="12dp"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- VS Badge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VS"
                android:textColor="#EF4444"
                android:textSize="42sp"
                android:textStyle="bold|italic"
                android:shadowColor="#F59E0B"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20"
                android:layout_gravity="center"/>
        </FrameLayout>

        <!-- Jugador 2 (RIVAL) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="16dp"
            app:strokeColor="#EF4444"
            app:strokeWidth="3dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#22EF4444"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POKÉMON 2 (RIVAL)"
                        android:textColor="#F87171"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:background="@drawable/bg_rounded_white"
                        android:backgroundTint="#1E293B"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp">

                        <EditText
                            android:id="@+id/etP2"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#64748B"
                            android:hint="Nombre o ID..."
                            android:textSize="14sp"
                            android:maxLines="1"
                            android:inputType="text"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_search"
                            app:tint="#F87171"/>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    app:cardBackgroundColor="#0F172A"
                    app:cardCornerRadius="8dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="2dp"
                    android:layout_marginStart="16dp">

                    <ImageView
                        android:id="@+id/ivPreviewP2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_menu_help"
                        app:tint="#64748B"
                        android:padding="12dp"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnPrepareBattle"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:backgroundTint="#22C55E"
            android:text="⚔️ PREPARAR BATALLA ⚔️"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="#15803D"
            app:strokeWidth="2dp"/>
    </LinearLayout>

    <!-- ESTADO 2: BATALLA (Oculto inicialmente) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBattleArena"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dividerLine"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Fondo de Batalla Clásico -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/pokedex_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomPanel"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#66000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottomPanel"/>

        <!-- Plataforma Rival -->
        <View
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_rounded_white"
            android:backgroundTint="#884CAF50"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="120dp"
            android:layout_marginEnd="16dp"
            android:scaleY="0.5"/>

        <ImageView
            android:id="@+id/ivP2Sprite"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Info Rival (Arriba Izquierda) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardP2"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardCornerRadius="8dp"
            app:strokeColor="#475569"
            app:strokeWidth="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/tvP2Name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="P2_NAME" android:textColor="#1E293B" android:textStyle="bold" android:textSize="16sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lv.50" android:textColor="#334155" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HP" android:textColor="#EAB308" android:textStyle="bold" android:textSize="10sp" android:layout_marginEnd="4dp" android:background="#1E293B" android:paddingHorizontal="4dp"/>
                    <ProgressBar android:id="@+id/pbP2Hp" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:max="100" android:progressTint="#22C55E" android:backgroundTint="#94A3B8"/>
                </LinearLayout>
                <TextView android:id="@+id/tvP2Hp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="100/100" android:textColor="#475569" android:textSize="12sp" android:textAlignment="viewEnd" android:textStyle="bold" android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Plataforma Jugador -->
        <View
            android:layout_width="250dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_rounded_white"
            android:backgroundTint="#884CAF50"
            app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="40dp"
            android:layout_marginStart="-30dp"
            android:scaleY="0.5"/>

        <ImageView
            android:id="@+id/ivP1Sprite"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Info Jugador (Abajo Derecha) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardP1"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardCornerRadius="8dp"
            app:strokeColor="#475569"
            app:strokeWidth="3dp"
            app:layout_constraintBottom_toTopOf="@+id/bottomPanel"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/tvP1Name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="P1_NAME" android:textColor="#1E293B" android:textStyle="bold" android:textSize="18sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lv.50" android:textColor="#334155" android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HP" android:textColor="#EAB308" android:textStyle="bold" android:textSize="12sp" android:layout_marginEnd="6dp" android:background="#1E293B" android:paddingHorizontal="4dp"/>
                    <ProgressBar android:id="@+id/pbP1Hp" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="12dp" android:max="100" android:progressTint="#22C55E" android:backgroundTint="#94A3B8"/>
                </LinearLayout>
                <TextView android:id="@+id/tvP1Hp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="100/100" android:textColor="#1E293B" android:textSize="14sp" android:textAlignment="viewEnd" android:textStyle="bold" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PANEL INFERIOR ESTILO GBA -->
        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:orientation="horizontal"
            android:background="#2E394A"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- CAJA DE TEXTO (TEXTBOX CLÁSICA) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp"
                app:strokeColor="#F59E0B"
                app:strokeWidth="6dp">

                <!-- Doble marco simulado -->
                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_rounded_white" android:backgroundTint="#00000000" android:layout_margin="3dp"/>

                <ScrollView
                    android:id="@+id/svLog"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:fadeScrollbars="false">
                    <TextView
                        android:id="@+id/tvBattleLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="¡La batalla está por comenzar!"
                        android:textColor="#1E293B"
                        android:textSize="26sp"
                        android:fontFamily="@font/pokemon_pixel"
                        android:lineSpacingExtra="6dp"/>
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>