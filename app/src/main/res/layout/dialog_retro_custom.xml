<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_game_over"
        android:padding="20dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tvRetroDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TÍTULO"
            android:textAlignment="center"
            android:textColor="#FACC15"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="@font/pokemon_pixel"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:layout_marginBottom="16dp" />

        <FrameLayout
            android:id="@+id/flRetroDialogIconContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_gold_frame"
            android:padding="8dp"
            android:layout_marginBottom="16dp">
            <ImageView
                android:id="@+id/ivRetroDialogIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_battle_text"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvRetroDialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mensaje"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textAlignment="center"
                android:fontFamily="@font/pokemon_pixel" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llRetroDialogOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRetroPositive"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/btn_retro_red"
            android:fontFamily="@font/pokemon_pixel"
            android:text="ACEPTAR"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRetroNegative"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/btn_retro_gray"
            android:fontFamily="@font/pokemon_pixel"
            android:text="CANCELAR"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>