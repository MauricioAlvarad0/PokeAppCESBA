<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="#1E293B"
    app:cardCornerRadius="20dp"
    app:strokeColor="#334155"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ CONFIGURACIÓN"
            android:textAlignment="center"
            android:textColor="#FFCC00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cambiar nombre de Entrenador:"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etTrainerName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#0F172A"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:paddingHorizontal="16dp"
            android:hint="Nombre del Entrenador"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSaveTrainerName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#2563EB"
            android:text="GUARDAR CAMBIOS"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnCerrarConfig"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCELAR"
            android:textColor="#94A3B8"
            android:textStyle="bold"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
