<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra/Borde inferior oscuro (efecto 3D) -->
    <item>
        <shape>
            <solid android:color="#7F0000"/>
            <corners android:radius="6dp"/>
            <stroke android:width="2dp" android:color="#212121"/>
        </shape>
    </item>
    <!-- Fondo principal rojo -->
    <item android:bottom="4dp">
        <shape>
            <solid android:color="#D32F2F"/>
            <corners android:radius="6dp"/>
            <stroke android:width="2dp" android:color="#212121"/>
        </shape>
    </item>
</layer-list>