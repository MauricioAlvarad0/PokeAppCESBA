<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer orange border -->
    <item>
        <shape>
            <solid android:color="#FDB827" /> <!-- Or maybe yellow/orange -->
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Inner white background with a dark thin stroke inside if we wanted,
         but the simplest is just inner white with padding -->
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
