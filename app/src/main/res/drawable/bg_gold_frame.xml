<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra/Borde oscuro del marco -->
    <item>
        <shape><solid android:color="#78350F"/></shape>
    </item>

    <!-- Brillo dorado claro -->
    <item android:bottom="4dp" android:right="4dp">
        <shape><solid android:color="#FDE047"/></shape>
    </item>

    <!-- Dorado Base medio -->
    <item android:left="4dp" android:top="4dp" android:bottom="4dp" android:right="4dp">
        <shape><solid android:color="#D97706"/></shape>
    </item>

    <!-- Fondo negro interno donde reposará la foto -->
    <item android:left="12dp" android:top="12dp" android:bottom="12dp" android:right="12dp">
        <shape><solid android:color="#000000"/></shape>
    </item>
</layer-list>